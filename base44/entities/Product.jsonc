{
  "name": "Product",
  "type": "object",
  "properties": {
    "nom": {
      "type": "string",
      "description": "Nom du produit"
    },
    "description": {
      "type": "string"
    },
    "prix": {
      "type": "number",
      "description": "Prix unitaire en FCFA"
    },
    "stock": {
      "type": "number",
      "description": "Quantit\u00e9 disponible"
    },
    "image": {
      "type": "string",
      "description": "URL de la photo du produit"
    },
    "category_id": {
      "type": "string"
    },
    "category_nom": {
      "type": "string"
    },
    "vendeur_nom": {
      "type": "string",
      "description": "Nom de la boutique, fig\u00e9 \u00e0 la cr\u00e9ation"
    }
  },
  "required": [
    "nom",
    "prix",
    "stock"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}