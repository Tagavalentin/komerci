{
  "name": "OrderItem",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "vendor_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_nom": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "quantite": {
      "type": "number"
    },
    "prix_unitaire": {
      "type": "number",
      "description": "Prix fig\u00e9 au moment de la commande"
    }
  },
  "required": [
    "order_id",
    "quantite",
    "prix_unitaire"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.vendor_id": "{{user.id}}"
        },
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}