{
  "name": "ProductReview",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "Produit \u00e9valu\u00e9"
    },
    "product_nom": {
      "type": "string",
      "description": "Nom du produit, fig\u00e9 au moment de l'avis"
    },
    "note": {
      "type": "number",
      "description": "Note de 1 \u00e0 5 \u00e9toiles"
    },
    "commentaire": {
      "type": "string",
      "description": "Commentaire libre du client"
    },
    "client_nom": {
      "type": "string",
      "description": "Nom affich\u00e9 de l'auteur de l'avis"
    }
  },
  "required": [
    "product_id",
    "note"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}