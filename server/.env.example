# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=komerci

# Auth
JWT_SECRET=change-me-in-production
# Comptes promus administrateurs à la création/connexion (séparés par des virgules)
ADMIN_EMAILS=

# URLs publiques
APP_URL=http://localhost:5173
# Doit correspondre exactement à l'URI de redirection configurée dans Google Cloud
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# FedaPay (laisser vide pour désactiver le paiement en ligne)
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_ENV=sandbox
PUBLIC_APP_URL=http://localhost:5173
